# Runtime artifacts
logs/
*.log

# Dependencies
node_modules/
# package.json declares no dependencies, so the lock `npm install` writes during `ocp update` records
# nothing (#61 deleted a stale tracked copy). If package.json ever gains a dependency, delete this
# line and commit the lock instead.
/package-lock.json

# Environment files
.env
.env.*

# Editor / OS scratch
.DS_Store
*.swp
*~

# test-features.mjs takes its suite lock at ./scratchpad/.suite.lock (#416). It exists only while a
# suite is running -- which is exactly when a `git add -A` from an agent will sweep it up.
scratchpad/

# Launchers written by setup.mjs (Step 4). start.sh embeds this host's absolute paths.
start_ocp.cmd
/start.sh
